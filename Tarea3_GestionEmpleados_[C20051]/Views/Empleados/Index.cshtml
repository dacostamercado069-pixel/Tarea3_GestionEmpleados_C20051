@using Tarea3_GestionEmpleados__C20051_.Models
@model IEnumerable<Empleado>

<h2>Lista de Empleados</h2>

<form method="get" class="mb-3 d-flex gap-2">
    <input class="form-control" type="text" name="busqueda" value="@ViewBag.Busqueda" placeholder="Buscar por nombre o departamento" />
    <button class="btn btn-primary" type="submit">Buscar</button>
</form>


<table class="table table-striped table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Nombre Completo</th>
            <th>Departamento</th>
            <th>Salario</th>
            <th>Fecha Ingreso</th>
            <th>Estado</th>
            <th>Acción</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.NombreCompleto</td>
                <td>@item.Departamento</td>
                <td>@item.Salario.ToString("C")</td>
                <td>@item.FechaIngreso.ToShortDateString()</td>

                <td>
                    @if (item.Activo)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Baja</span>
                    }
                </td>

                <td>
                    <form asp-action="ToggleActivo" method="post">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button class="btn btn-sm btn-warning" type="submit">
                            @(item.Activo ? "Dar de Baja" : "Activar")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<br />


<div>
    @{
        int paginaActual = ViewBag.Pagina;
        int totalPaginas = ViewBag.TotalPaginas;
        string busqueda = ViewBag.Busqueda;
    }


    @if (paginaActual > 1)
    {
        <a href="?busqueda=@busqueda&pagina=@(paginaActual - 1)">Anterior</a>
    }
    else
    {
        <span>Anterior</span>
    }


    <span> Página @paginaActual de @totalPaginas </span>


    @if (paginaActual < totalPaginas)
    {
        <a href="?busqueda=@busqueda&pagina=@(paginaActual + 1)">Siguiente</a>
    }
    else
    {
        <span>Siguiente</span>
    }
</div>