@using Tarea3_GestionEmpleados__C20051_.Models
@model IEnumerable<Empleado>

<h2 class="mb-3">Lista de Empleados</h2>

<a class="btn btn-success mb-3" href="/Empleados/Create">Nuevo Empleado</a>

<form method="get" class="mb-3 d-flex gap-2">
    <input class="form-control" type="text" name="busqueda" value="@ViewBag.Busqueda"
           placeholder="Buscar por nombre o departamento" />
    <button class="btn btn-primary">Buscar</button>
</form>

<p><strong>Total:</strong> @ViewBag.Total</p>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Nombre</th>
            <th>Departamento</th>
            <th>Salario</th>
            <th>Fecha</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.NombreCompleto</td>
                <td>@item.Departamento</td>
                <td>@item.Salario.ToString("C")</td>
                <td>@item.FechaIngreso.ToShortDateString()</td>

                <td>
                    @if (item.Activo)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Dado de Baja</span>
                    }
                </td>

                <td>
                    <a class="btn btn-sm btn-info" href="/Empleados/Edit/@item.Id">Editar</a>

                    <form asp-action="ToggleActivo" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.Id" />
                        <button class="btn btn-sm btn-warning">
                            @(item.Activo ? "Dar de Baja" : "Activar")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    @{
        int paginaActual = ViewBag.Pagina;
        int totalPaginas = ViewBag.TotalPaginas;
        string busqueda = ViewBag.Busqueda;
    }

    @if (paginaActual > 1)
    {
        <a class="btn btn-outline-primary btn-sm"
           href="?busqueda=@busqueda&pagina=@(paginaActual - 1)">Anterior</a>
    }

    <span class="mx-2">Página @paginaActual de @totalPaginas</span>

    @if (paginaActual < totalPaginas)
    {
        <a class="btn btn-outline-primary btn-sm"
           href="?busqueda=@busqueda&pagina=@(paginaActual + 1)">Siguiente</a>
    }
</div>